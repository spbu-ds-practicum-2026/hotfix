APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Подключение к PostgreSQL из скриптов, запущенных на хосте.
POSTGRES_SHARD_0_HOST=127.0.0.1
POSTGRES_SHARD_0_PORT=5433
POSTGRES_SHARD_0_DB=verdict
POSTGRES_SHARD_0_USER=verdict
POSTGRES_SHARD_0_PASSWORD=change_me

POSTGRES_SHARD_1_HOST=127.0.0.1
POSTGRES_SHARD_1_PORT=5434
POSTGRES_SHARD_1_DB=verdict
POSTGRES_SHARD_1_USER=verdict
POSTGRES_SHARD_1_PASSWORD=change_me

# Третий шард нужен только для демонстрации rebalancer (add-shard 2); без него строки можно не задавать.
# POSTGRES_SHARD_2_HOST=127.0.0.1
# POSTGRES_SHARD_2_PORT=5435
# POSTGRES_SHARD_2_DB=verdict
# POSTGRES_SHARD_2_USER=verdict
# POSTGRES_SHARD_2_PASSWORD=change_me

# Шарды на кольце consistent hashing. ОДИНАКОВЫЕ значения во всех сервисах.
# После rebalancer add-shard/remove-shard подставьте напечатанное значение ACTIVE_SHARDS.
ACTIVE_SHARDS=postgres_shard_0,postgres_shard_1
SHARD_VIRTUAL_NODES=128

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=verdict
RABBITMQ_PASSWORD=change_me

JUDGE0_URL=http://judge0:2358

LEASE_SECONDS=30
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=30

# Порты шардов на хосте для services/storage/compose.yaml (необязательно, по умолчанию 5433, 5434, 5435)
# POSTGRES_SHARD_0_PUBLISHED_PORT=5433
# POSTGRES_SHARD_1_PUBLISHED_PORT=5434
# POSTGRES_SHARD_2_PUBLISHED_PORT=5435